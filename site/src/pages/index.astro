---
// Homepage = primary GBP category (Pest control service) + home city (Sheboygan Falls) + county.
// Every claim is from the old site, the GBP or Jeremy's notes (see CLAUDE.md).
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Steps from '../components/Steps.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import ServiceCards from '../components/ServiceCards.astro';
import { site, img800 } from '../data/site';
import { areas } from '../data/areas';
import { faqs } from '../data/faqs';

const why = [
  { t: 'Family owned & operated', d: 'Trish and Jason Yost started B.E.S.T. in 2018. You get personalized service without the corporate red tape.' },
  { t: 'Certified & highly trained', d: 'Our technicians hold Wisconsin structural pesticide applicator certification, and Jason is a Wisconsin certified contractor.' },
  { t: 'Targeted, responsible treatment', d: 'No broad-spectrum spraying. We treat the pest you have, using environmentally responsible methods whenever possible.' },
  { t: 'Fast, flexible & polite', d: 'Prompt, professional and polite. Customers mention quick scheduling and clear explanations.' },
];
---
<Base
  title="Pest Control in Sheboygan Falls, WI | B.E.S.T. Pest Control"
  description="Family-owned pest control and wildlife removal in Sheboygan Falls and Sheboygan County: wasps, mice, ants, bed bugs and raccoons. Call (920) 698-9933."
>
  <PageHero big photo="best-pest-control-truck-sheboygan-falls" eyebrow="Family owned · Serving Sheboygan County" title="Pest Control in Sheboygan Falls, WI" sub="Bugs, rodents and wildlife handled by a family-owned local team. Prompt, professional and polite, from our shop on Monroe Street." chips={[`${site.rating.value}★ Google rating`, 'Family owned since 2018', 'Woman-owned']} />

  <section class="section">
    <div class="container grid grid-2">
      <div>
        <span class="eyebrow">Who we are</span>
        <h2 class="section-title">Your Local Pest &amp; Wildlife Pros</h2>
        <div class="answer"><p>{site.description}</p></div>
        <p class="pad">B.E.S.T. stands for Bug Extermination Services by Trish. Trish brings years of customer service and more than a decade in pest control; Jason brings a journeyman millwright background and decades of hands-on experience finding how pests get into buildings. Together with a small team of certified technicians, they treat every home and business like it is their own.</p>
        <div class="btn-row">
          <a class="btn btn--red" href={site.quoteUrl}>{site.ctaLabel}</a>
          <a class="btn btn--outline" href="/about/">Meet the Team</a>
        </div>
      </div>
      <figure class="photo pic"><img src={img800('trish-and-jason-yost-owners')} alt="Trish and Jason Yost, owners of B.E.S.T. Pest Control Services in Sheboygan Falls" width="800" height="571" loading="lazy" /></figure>
    </div>
  </section>

  <section class="section section--paper">
    <div class="container">
      <span class="eyebrow">Services</span>
      <h2 class="section-title">Pest Control Services</h2>
      <p class="lead">From yellow jackets in the siding to raccoons in the attic, one call covers it. We work with homeowners, apartment complexes, restaurants, bars and commercial properties.</p>
      <div class="mt"><ServiceCards /></div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <span class="eyebrow">Why choose us</span>
      <h2 class="section-title">Why Sheboygan County Calls B.E.S.T.</h2>
      <div class="grid grid-4 mt">{why.map((w) => <div class="card"><h3>{w.t}</h3><p>{w.d}</p></div>)}</div>
      <div class="proof">
        <a class="proof__item" href={site.social.google} rel="noopener">
          <strong>{site.rating.value} ★★★★★</strong>
          <span>{site.rating.count} Google reviews</span>
        </a>
        <div class="proof__item"><strong>Best Pest Company</strong><span>2024 Community’s Choice Awards, Best of Fond du Lac County</span></div>
        <div class="proof__item"><strong>Runner-up</strong><span>Best of Sheboygan County</span></div>
      </div>
    </div>
  </section>

  <section class="section section--dark">
    <div class="container grid grid-2">
      <div>
        <span class="eyebrow">Long-term rodent exclusion</span>
        <h2 class="section-title">Stop Trapping Mice Every Fall</h2>
        <p>Rodents are one of the most stubborn pests to get rid of. With more than 27 years in maintenance, construction and facilities management behind us, we find the entry points in your building and work out the most effective, cost-effective way to seal them.</p>
        <p>A certified specialist inspects your home inside and out and gives you a detailed rodent prevention plan.</p>
        <div class="btn-row"><a class="btn btn--red" href="/rodent-exclusion/">About Rodent Exclusion</a></div>
      </div>
      <figure class="photo pic"><img src={img800('technician-sealing-foundation-exclusion')} alt="Technician sealing a gap at a home’s foundation to keep mice out" width="800" height="600" loading="lazy" /></figure>
    </div>
  </section>

  <Steps />

  <section class="section">
    <div class="container quote-wrap">
      <blockquote class="testimonial">
        <p>“I just got off the phone with Trish. She made me feel heard and offered free advice… Very informative, very kind, very professional. Pricing seems more than reasonable.”</p>
        <cite>Marissa, local homeowner</cite>
      </blockquote>
    </div>
  </section>

  <section class="section section--paper">
    <div class="container">
      <span class="eyebrow">Service areas</span>
      <h2 class="section-title">Where We Work</h2>
      <p class="lead">Based in {site.city}, serving all of Sheboygan County and most of Calumet, Fond du Lac, Manitowoc, Ozaukee and Washington counties, from Plymouth to West Bend and Two Rivers to Grafton.</p>
      <ul class="areas">{areas.map((a) => <li><a href={`/service-areas/${a.slug}/`}>{a.name}</a></li>)}</ul>
    </div>
  </section>

  <Faq faqs={faqs.slice(0, 6)} />
  <CtaBand photo="best-pest-control-team-sheboygan-falls" />
</Base>

<style>
  .pad { margin: 22px 0 26px; }
  .pic { margin: 0; aspect-ratio: 4 / 3; }
  .pic img { width: 100%; height: 100%; object-fit: cover; }
  .mt { margin-top: 30px; }
  .section--dark p { font-size: 19px; }
  .proof { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-top: 34px; }
  .proof__item { display: block; background: var(--ink); color: #fff; border-radius: var(--radius); padding: 22px 24px; text-decoration: none; border-left: 6px solid var(--red); }
  .proof__item strong { display: block; font-family: var(--head); font-size: 28px; color: var(--red); text-transform: uppercase; line-height: 1.1; }
  .proof__item span { font-size: 16px; color: #ddd; }
  @media (max-width: 760px) { .proof { grid-template-columns: 1fr; } }
  .quote-wrap { max-width: 880px; }
  .testimonial { margin: 0; text-align: center; }
  .testimonial p { font-family: var(--head); font-size: clamp(26px, 3.4vw, 36px); line-height: 1.25; color: var(--ink); }
  .testimonial cite { font-style: normal; font-weight: 700; color: var(--red-text); letter-spacing: .06em; text-transform: uppercase; }
  .areas { list-style: none; padding: 0; margin: 20px 0 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 10px 20px; }
  .areas a { font-family: var(--head); font-weight: 700; font-size: 21px; text-transform: uppercase; color: var(--ink); text-decoration: none; border-bottom: 3px solid var(--red); }
</style>
