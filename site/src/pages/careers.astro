---
// Careers page, from the old site's careers page (2026-11-25). Apply link = client's JotForm application.
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import { site, img800 } from '../data/site';
import { breadcrumbs } from '../data/schema';
const crumbs = [{ name: 'Careers', href: '/careers/' }];
const apply = 'https://form.jotform.com/260464677113054';
const jobs = [
  { t: 'Full-Time Service Technician', d: 'Inspect and treat homes and businesses for insects, stinging insects, rodents and wildlife across Sheboygan County and nearby counties, and help customers keep pests out for good.' },
  { t: 'Customer Service Representative (CSR)', d: 'Be the friendly voice customers hear first: answer calls and messages, schedule service and help people with their pest questions.' },
];
---
<Base title="Careers at B.E.S.T. Pest Control | Sheboygan Falls, WI" description="Join B.E.S.T. Pest Control Services in Sheboygan Falls. Now hiring full-time service technicians and customer service representatives. Apply online." schema={[breadcrumbs(crumbs)]}>
  <PageHero photo="best-pest-control-team-park-bench" eyebrow="Careers" title="Work With the B.E.S.T." sub="A fast-growing, family-run pest control company in Sheboygan Falls. We’re adding to our team." crumbs={crumbs} primary={{ label: 'Apply Today', href: apply }} secondary={{ label: `Call ${site.phone}`, href: `tel:${site.phoneIntl}` }} />
  <section class="section">
    <div class="container grid grid-2 top">
      <div>
        <div class="answer"><p>B.E.S.T. Pest Control Services is a fast-growing, locally owned and operated pest control company serving the Sheboygan area and surrounding communities. Due to continued growth, we are hiring full-time service technicians and customer service representatives.</p></div>
        <div class="copy">
          <p>As a family-run business, we focus on delivering exceptional service, building lasting customer relationships, and creating a supportive team environment where employees can grow and succeed.</p>
          <p>We’re looking for dependable, motivated people who take pride in their work, enjoy helping people, and want to be part of a company that values professionalism, teamwork and community connection.</p>
        </div>
        <a class="btn btn--red" href={apply} target="_blank" rel="noopener">Apply Today</a>
      </div>
      <figure class="photo pic"><img src={img800('best-pest-control-team-sheboygan-falls')} alt="The B.E.S.T. Pest Control Services team in Sheboygan Falls" width="800" height="533" loading="lazy" /></figure>
    </div>
  </section>
  <section class="section section--paper">
    <div class="container">
      <span class="eyebrow">Open positions</span>
      <h2 class="section-title">We’re Hiring</h2>
      <div class="grid grid-2 jobs">
        {jobs.map((j) => (
          <div class="card">
            <h3>{j.t}</h3>
            <p>{j.d}</p>
            <a class="btn btn--dark" href={apply} target="_blank" rel="noopener">Apply Now</a>
          </div>
        ))}
      </div>
    </div>
  </section>
  <section class="section">
    <div class="container narrow">
      <span class="eyebrow">What we look for</span>
      <h2 class="section-title">Is This You?</h2>
      <ul class="checks">
        <li>Dependable and motivated</li>
        <li>Takes pride in doing the job right</li>
        <li>Enjoys helping people</li>
        <li>Values professionalism, teamwork and community connection</li>
      </ul>
      <p>Questions about working with us? Call <a href={`tel:${site.phoneIntl}`}>{site.phone}</a> or email <a href={`mailto:${site.email}`}>{site.email}</a>.</p>
    </div>
  </section>
  <CtaBand photo="best-pest-control-crew-sheboygan-river" />
</Base>

<style>
  .copy { margin: 24px 0; }
  .pic { margin: 0; aspect-ratio: 3 / 2; }
  .pic img { width: 100%; height: 100%; object-fit: cover; }
  .top { align-items: start; }
  .jobs { margin-top: 26px; align-items: stretch; gap: 26px; }
  .jobs .card { display: flex; flex-direction: column; }
  .jobs .card .btn { align-self: flex-start; margin-top: auto; }
  .narrow { max-width: 820px; }
</style>
